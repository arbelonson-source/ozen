{
 "about": "Cases for CaptionAnnouncer, what VoiceOver and TalkBack read out (or send to a braille display) as caption lines finish, read by both OzenKitTests (CaptionAnnouncerSharedCasesTests, Swift) and core CaptionAnnouncerSharedCasesTest (Kotlin), in English. Each sequence runs one announcer: a show step passes the lines on screen and expects the announcement (null when nothing is read); a skip step is skipLinesSoFar. A line is [id, text] plus committed (default true), speaker (a key of names), start and end (seconds, default 0), provisional and unsure (default false); id n is the UUID 00000000-0000-0000-0000-n padded to 12 digits.",
 "sequences": [
  {"note": "a finished line is read once", "steps": [{"show": [{"id": 1, "text": "Hello there"}], "say": "Hello there"}, {"show": [{"id": 1, "text": "Hello there"}], "say": null}]},
  {"note": "a line still being said waits until it is finished", "steps": [{"show": [{"id": 1, "text": "Hel", "committed": false}], "say": null}, {"show": [{"id": 1, "text": "Hello there"}], "say": "Hello there"}]},
  {"note": "a line that only grew reads just the new words", "steps": [{"show": [{"id": 1, "text": "The doctor said"}], "say": "The doctor said"}, {"show": [{"id": 1, "text": "The doctor said one pill"}], "say": "one pill"}, {"show": [{"id": 1, "text": "The doctor said one pill twice a day"}], "say": "twice a day"}]},
  {"note": "a grown line keeps its speaker's name to itself", "names": {"1": "Dana", "2": "Noa"}, "steps": [{"show": [{"id": 1, "text": "The doctor said", "speaker": 1}], "say": "Dana: The doctor said"}, {"show": [{"id": 1, "text": "The doctor said one pill", "speaker": 1}], "say": "one pill"}]},
  {"note": "a speaker found meanwhile leads the new words with the name", "names": {"1": "Dana", "2": "Noa"}, "steps": [{"show": [{"id": 1, "text": "The doctor said"}], "say": "The doctor said"}, {"show": [{"id": 1, "text": "The doctor said one pill", "speaker": 1}], "say": "Dana: one pill"}]},
  {"note": "a word that only grew longer is read again in full", "steps": [{"show": [{"id": 1, "text": "I took a pill"}], "say": "I took a pill"}, {"show": [{"id": 1, "text": "I took a pills"}], "say": "I took a pills"}]},
  {"note": "a correction that changes words is read again in full", "steps": [{"show": [{"id": 1, "text": "The doctor said"}], "say": "The doctor said"}, {"show": [{"id": 1, "text": "The doctors say"}], "say": "The doctors say"}]},
  {"note": "an unsure line is read with the warning, its new words without it", "steps": [{"show": [{"id": 1, "text": "Take one", "unsure": true}], "say": "May not have been heard correctly. Take one"}, {"show": [{"id": 1, "text": "Take one tonight", "unsure": true}], "say": "tonight"}]},
  {"note": "a cut-off mark alone is not read; words after it are", "steps": [{"show": [{"id": 1, "text": "Hello"}], "say": "Hello"}, {"show": [{"id": 1, "text": "Hello …"}], "say": null}, {"show": [{"id": 1, "text": "Hello there …"}], "say": "there"}]},
  {"note": "lines finished together go out as one announcement, in order", "steps": [{"show": [{"id": 1, "text": "One"}, {"id": 2, "text": "Two"}, {"id": 3, "text": "Three", "committed": false}], "say": "One\nTwo"}]},
  {"note": "the name leads a line only when the speaker changes", "names": {"1": "Dana", "2": "Noa"}, "steps": [{"show": [{"id": 1, "text": "Hi", "speaker": 1}], "say": "Dana: Hi"}, {"show": [{"id": 1, "text": "Hi", "speaker": 1}, {"id": 2, "text": "Again", "speaker": 1}], "say": "Again"}, {"show": [{"id": 1, "text": "Hi", "speaker": 1}, {"id": 2, "text": "Again", "speaker": 1}, {"id": 3, "text": "Yes", "speaker": 2}], "say": "Noa: Yes"}]},
  {"note": "after five quiet minutes the same speaker is named again", "names": {"1": "Dana", "2": "Noa"}, "steps": [{"show": [{"id": 1, "text": "Hi", "speaker": 1, "end": 2}], "say": "Dana: Hi"}, {"show": [{"id": 1, "text": "Hi", "speaker": 1, "end": 2}, {"id": 2, "text": "Still here", "speaker": 1, "start": 303, "end": 305}], "say": "Dana: Still here"}, {"show": [{"id": 1, "text": "Hi", "speaker": 1, "end": 2}, {"id": 2, "text": "Still here", "speaker": 1, "start": 303, "end": 305}, {"id": 3, "text": "Soon after", "speaker": 1, "start": 400, "end": 401}], "say": "Soon after"}]},
  {"note": "a grown line after a quiet stretch is not named again", "names": {"1": "Dana", "2": "Noa"}, "steps": [{"show": [{"id": 1, "text": "Hi", "speaker": 1, "end": 2}], "say": "Dana: Hi"}, {"show": [{"id": 1, "text": "Hi", "speaker": 1, "end": 2}, {"id": 2, "text": "Back", "speaker": 1, "start": 400, "end": 401}], "say": "Dana: Back"}, {"show": [{"id": 1, "text": "Hi", "speaker": 1, "end": 2}, {"id": 2, "text": "Back again", "speaker": 1, "start": 400, "end": 420}], "say": "again"}]},
  {"note": "turning on mid-conversation skips the backlog but not a line still being said", "steps": [{"skip": [{"id": 1, "text": "Old"}, {"id": 2, "text": "Still say", "committed": false}]}, {"show": [{"id": 1, "text": "Old"}, {"id": 2, "text": "Still saying it"}, {"id": 3, "text": "New"}], "say": "Still saying it\nNew"}]},
  {"note": "after the screen is cleared the speaker is named again", "names": {"1": "Dana", "2": "Noa"}, "steps": [{"show": [{"id": 1, "text": "Hi", "speaker": 1}], "say": "Dana: Hi"}, {"show": [], "say": null}, {"show": [{"id": 2, "text": "Again", "speaker": 1}], "say": "Dana: Again"}]},
  {"note": "a provisionally finished line that reopens and grows reads just the new words", "steps": [{"show": [{"id": 1, "text": "Hello", "provisional": true}], "say": "Hello"}, {"show": [{"id": 1, "text": "Hello there", "committed": false}], "say": null}, {"show": [{"id": 1, "text": "Hello there"}], "say": "there"}]},
  {"note": "blank finished lines are skipped", "steps": [{"show": [{"id": 1, "text": "   "}], "say": null}, {"show": [{"id": 1, "text": "   "}, {"id": 2, "text": "Word"}], "say": "Word"}]},
  {"note": "new words after a no-break space", "steps": [{"show": [{"id": 1, "text": "Hello"}], "say": "Hello"}, {"show": [{"id": 1, "text": "Hello\u00A0there"}], "say": "there"}]},
  {"note": "new words glued on without a space read the line again", "steps": [{"show": [{"id": 1, "text": "Hello"}], "say": "Hello"}, {"show": [{"id": 1, "text": "Hellothere"}], "say": "Hellothere"}]},
  {"note": "a grown Hebrew line", "steps": [{"show": [{"id": 1, "text": "הרופא אמר"}], "say": "הרופא אמר"}, {"show": [{"id": 1, "text": "הרופא אמר כדור אחד"}], "say": "כדור אחד"}]},
  {"note": "ten lines at once are all read", "steps": [{"show": [{"id": 1, "text": "Line 1"}, {"id": 2, "text": "Line 2"}, {"id": 3, "text": "Line 3"}, {"id": 4, "text": "Line 4"}, {"id": 5, "text": "Line 5"}, {"id": 6, "text": "Line 6"}, {"id": 7, "text": "Line 7"}, {"id": 8, "text": "Line 8"}, {"id": 9, "text": "Line 9"}, {"id": 10, "text": "Line 10"}], "say": "Line 1\nLine 2\nLine 3\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10"}]},
  {"note": "a line that grew and was corrected at once is read again in full", "steps": [{"show": [{"id": 1, "text": "The doctor said"}], "say": "The doctor said"}, {"show": [{"id": 1, "text": "The doctors said one pill"}], "say": "The doctors said one pill"}]},
  {"note": "an earlier line grows while a new one finishes", "steps": [{"show": [{"id": 1, "text": "First"}, {"id": 2, "text": "Second", "committed": false}], "say": "First"}, {"show": [{"id": 1, "text": "First part"}, {"id": 2, "text": "Second line"}], "say": "part\nSecond line"}]}
 ]
}
