 "sustained": ["boiling", "civil_defense_siren", "siren", "water_tap_faucet", "whistling"],
 "sequences": [
  {"note": "a doorbell alerts, then waits out the 20-second cooldown, exactly 20 s later it alerts again", "steps": [{"hear": ["door_bell", 0.7, 100], "alert": "door_bell"}, {"hear": ["door_bell", 0.9, 110], "alert": null}, {"hear": ["door_bell", 0.7, 119.99], "alert": null}, {"hear": ["door_bell", 0.7, 120], "alert": "door_bell"}]},
  {"note": "the 0.6 confidence floor is inclusive", "steps": [{"hear": ["door_bell", 0.59, 100], "alert": null}, {"hear": ["door_bell", 0.6, 101], "alert": "door_bell"}]},
  {"note": "labels outside the catalog never alert", "steps": [{"hear": ["speech", 0.99, 100], "alert": null}, {"hear": ["Door_Bell", 0.99, 101], "alert": null}, {"hear": ["", 0.99, 102], "alert": null}]},
  {"note": "by default a low sound is dropped and a medium one alerts", "steps": [{"hear": ["cat_meow", 0.9, 100], "alert": null}, {"hear": ["dog_howl", 0.9, 101], "alert": "dog_howl"}, {"hear": ["thunder", 0.9, 102], "alert": "thunder"}]},
  {"note": "critical only", "preferences": {"minimumImportance": 3}, "steps": [{"hear": ["door_bell", 0.95, 100], "alert": null}, {"hear": ["smoke_detector", 0.95, 101], "alert": "smoke_detector"}, {"hear": ["glass_breaking", 0.7, 102], "alert": "glass_breaking"}]},
  {"note": "everything, low included", "preferences": {"minimumImportance": 0}, "steps": [{"hear": ["cat", 0.9, 100], "alert": "cat"}, {"hear": ["music", 0.61, 101], "alert": "music"}]},
  {"note": "alerts turned off", "preferences": {"isEnabled": false}, "steps": [{"hear": ["smoke_detector", 0.99, 100], "alert": null}, {"hear": ["civil_defense_siren", 0.99, 101], "alert": null}]},
  {"note": "muting the ringtone mutes the same ring under its other label, not the plain phone", "preferences": {"mutedIdentifiers": ["ringtone"]}, "steps": [{"hear": ["telephone_bell_ringing", 0.9, 100], "alert": null}, {"hear": ["ringtone", 0.9, 101], "alert": null}, {"hear": ["telephone", 0.9, 102], "alert": "telephone"}]},
  {"note": "a sensitive doorbell needs only 0.4; a knock still needs 0.6", "preferences": {"sensitiveIdentifiers": ["door_bell"]}, "steps": [{"hear": ["door_bell", 0.45, 100], "alert": "door_bell"}, {"hear": ["knock", 0.45, 101], "alert": null}, {"hear": ["door_bell", 0.39, 130], "alert": null}, {"hear": ["door_bell", 0.4, 131], "alert": "door_bell"}]},
  {"note": "a sensitive kettle (whistling) lowers the floor for boiling too, which still needs a second window", "preferences": {"sensitiveIdentifiers": ["whistling"]}, "steps": [{"hear": ["boiling", 0.45, 100], "alert": null}, {"hear": ["boiling", 0.5, 101], "alert": "boiling"}]},
  {"note": "muted and sensitive: muted wins", "preferences": {"mutedIdentifiers": ["door_bell"], "sensitiveIdentifiers": ["door_bell"]}, "steps": [{"hear": ["door_bell", 0.5, 100], "alert": null}, {"hear": ["door_bell", 0.9, 200], "alert": null}]},
  {"note": "a siren needs a second window within 2 s, then cools down", "steps": [{"hear": ["siren", 0.7, 100], "alert": null}, {"hear": ["siren", 0.7, 101.5], "alert": "siren"}, {"hear": ["siren", 0.7, 103], "alert": null}, {"hear": ["siren", 0.7, 121.5], "alert": null}]},
  {"note": "a second window more than 2 s later starts over", "steps": [{"hear": ["siren", 0.7, 100], "alert": null}, {"hear": ["siren", 0.7, 102.01], "alert": null}, {"hear": ["siren", 0.7, 103], "alert": "siren"}]},
  {"note": "a second window exactly 2 s later confirms", "steps": [{"hear": ["water_tap_faucet", 0.7, 100], "alert": null}, {"hear": ["water_tap_faucet", 0.7, 102], "alert": "water_tap_faucet"}]},
  {"note": "two labels in one reading are one spike; boiling then whistling is one kettle", "steps": [{"hear": ["boiling", 0.7, 100], "alert": null}, {"hear": ["whistling", 0.7, 100], "alert": null}, {"hear": ["whistling", 0.7, 101], "alert": "whistling"}, {"hear": ["boiling", 0.7, 102], "alert": null}]},
  {"note": "an air raid siren at 0.85 alerts at once; below that it waits for a second window", "steps": [{"hear": ["civil_defense_siren", 0.85, 100], "alert": "civil_defense_siren"}, {"hear": ["civil_defense_siren", 0.84, 200], "alert": null}, {"hear": ["civil_defense_siren", 0.84, 201], "alert": "civil_defense_siren"}]},
  {"note": "a smoke detector alerts on its first window", "steps": [{"hear": ["smoke_detector", 0.61, 100], "alert": "smoke_detector"}, {"hear": ["smoke_detector", 0.99, 110], "alert": null}, {"hear": ["smoke_detector", 0.99, 120], "alert": "smoke_detector"}]},
  {"note": "one cooldown per sound: the ring under two labels, a shout and a yell", "steps": [{"hear": ["telephone_bell_ringing", 0.7, 100], "alert": "telephone_bell_ringing"}, {"hear": ["ringtone", 0.7, 105], "alert": null}, {"hear": ["ringtone", 0.7, 121], "alert": "ringtone"}, {"hear": ["shout", 0.7, 0], "alert": "shout"}, {"hear": ["yell", 0.7, 10], "alert": null}, {"hear": ["yell", 0.7, 20], "alert": "yell"}]},
  {"note": "different sounds don't share a cooldown", "steps": [{"hear": ["door_bell", 0.7, 100], "alert": "door_bell"}, {"hear": ["knock", 0.7, 100], "alert": "knock"}, {"hear": ["dog_bark", 0.7, 101], "alert": "dog_bark"}]},
  {"note": "the clock going back doesn't hold a new alert back", "steps": [{"hear": ["door_bell", 0.7, 1000], "alert": "door_bell"}, {"hear": ["door_bell", 0.7, 990], "alert": "door_bell"}, {"hear": ["door_bell", 0.7, 995], "alert": null}, {"hear": ["door_bell", 0.7, 0], "alert": "door_bell"}, {"hear": ["door_bell", 0.7, -5], "alert": "door_bell"}]},
  {"note": "starting over clears cooldowns and a waiting siren", "steps": [{"hear": ["door_bell", 0.7, 100], "alert": "door_bell"}, {"reset": true}, {"hear": ["door_bell", 0.7, 101], "alert": "door_bell"}, {"hear": ["siren", 0.7, 102], "alert": null}, {"reset": true}, {"hear": ["siren", 0.7, 103], "alert": null}, {"hear": ["siren", 0.7, 104], "alert": "siren"}]},
  {"note": "a lower floor than the sensitive one wins for a sensitive sound", "preferences": {"sensitiveIdentifiers": ["door_bell"]}, "policy": {"minimumConfidence": 0.3}, "steps": [{"hear": ["door_bell", 0.35, 100], "alert": "door_bell"}, {"hear": ["knock", 0.35, 101], "alert": "knock"}, {"hear": ["knock", 0.29, 130], "alert": null}]},
  {"note": "a shorter cooldown and a longer persistence window", "policy": {"cooldownSeconds": 5, "persistenceWindowSeconds": 5}, "steps": [{"hear": ["door_bell", 0.7, 0], "alert": "door_bell"}, {"hear": ["door_bell", 0.7, 4.9], "alert": null}, {"hear": ["door_bell", 0.7, 5], "alert": "door_bell"}, {"hear": ["siren", 0.7, 10], "alert": null}, {"hear": ["siren", 0.7, 14], "alert": "siren"}, {"hear": ["siren", 0.7, 30], "alert": null}]},
  {"note": "a lower emergency level alerts a running tap at once", "policy": {"emergencyConfidence": 0.7}, "steps": [{"hear": ["water_tap_faucet", 0.75, 100], "alert": "water_tap_faucet"}]}
 ],
 "matching": [
  {"note": "known labels at or above the floor, the most important first", "minimumConfidence": 0.3, "candidates": [["speech", 0.9], ["door_bell", 0.5], ["smoke_detector", 0.4], ["cat", 0.95], ["music", 0.2], ["dog_howl", 0.3]], "expected": [["smoke_detector", 0.4], ["door_bell", 0.5], ["dog_howl", 0.3], ["cat", 0.95]]},
  {"note": "the same importance, the most confident first", "minimumConfidence": 0.3, "candidates": [["door_bell", 0.5], ["knock", 0.8], ["baby_crying", 0.6]], "expected": [["knock", 0.8], ["baby_crying", 0.6], ["door_bell", 0.5]]},
  {"note": "nothing heard", "minimumConfidence": 0.3, "candidates": [], "expected": []},
  {"note": "a kettle under both labels in one reading", "minimumConfidence": 0.5, "candidates": [["whistling", 0.55], ["boiling", 0.7], ["music", 0.9]], "expected": [["boiling", 0.7], ["whistling", 0.55], ["music", 0.9]]}
 ],
 "banners": [
  {"alert": "door_bell", "shown": null, "takesBanner": true, "bannerSeconds": 8},
  {"alert": "door_bell", "shown": "smoke_detector", "takesBanner": false, "bannerSeconds": 8},
  {"alert": "smoke_detector", "shown": "door_bell", "takesBanner": true, "bannerSeconds": 24},
  {"alert": "door_bell", "shown": "knock", "takesBanner": true, "bannerSeconds": 8},
  {"alert": "cat", "shown": "dog_howl", "takesBanner": false, "bannerSeconds": 8},
  {"alert": "civil_defense_siren", "shown": null, "takesBanner": true, "bannerSeconds": 24},
  {"alert": "dog_howl", "shown": "cat", "takesBanner": true, "bannerSeconds": 8}
 ],
 "gate": [
  {"on": true, "length": 3, "passed": [3]},
  {"on": false, "length": 5, "passed": []},
  {"on": false, "length": 5, "passed": []},
  {"on": true, "length": 2, "passed": [0, 2]},
