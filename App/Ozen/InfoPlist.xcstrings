{
  "sourceLanguage": "he",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen የማይክሮፎኑን ድምፅ ከስልኩ በፍጥነት ካፕሽን ወደሚሰራው የቤትዎ ኮምፒውተር መላክ ይችላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Ozen إرسال صوت الميكروفون إلى حاسوبك في المنزل، الذي يكتب الترجمة النصية أسرع من الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen kann den Ton des Mikrofons an Ihren Computer zu Hause senden, der schneller untertitelt als das Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen can send the microphone to your own computer at home, which captions faster than the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen puede enviar el sonido del micrófono a tu ordenador de casa, que subtitula más rápido que el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen peut envoyer le son du micro à votre ordinateur à la maison, qui sous-titre plus vite que le téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוזן יכולה לשלוח את הקול למחשב שלכם בבית, שכותב כתוביות מהר יותר מהטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen माइक्रोफ़ोन की आवाज़ आपके घर के कंप्यूटर पर भेज सकता है, जो फ़ोन से तेज़ कैप्शन बनाता है।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ozen pode enviar o som do microfone para o seu computador em casa, que legenda mais depressa do que o telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen может отправлять звук с микрофона на ваш домашний компьютер, который делает субтитры быстрее телефона."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen може надсилати звук із мікрофона на ваш домашній комп’ютер, який робить субтитри швидше за телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen 可以把麦克风的声音发送到你家里的电脑，它生成字幕比手机更快。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen ውይይትን በቀጥታ በካፕሽን ለማሳየት ማይክሮፎኑን ይፈልጋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Ozen إلى الميكروفون لعرض ترجمة نصية فورية للمحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen braucht das Mikrofon, um Gespräche live zu untertiteln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen needs the microphone to caption conversation live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen necesita el micrófono para subtitular la conversación en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen a besoin du micro pour sous-titrer la conversation en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוזן צריכה את המיקרופון כדי להציג כתוביות לשיחה בזמן אמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत के लाइव कैप्शन दिखाने के लिए Ozen को माइक्रोफ़ोन चाहिए।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ozen precisa do microfone para legendar a conversa em direto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen нужен микрофон, чтобы показывать субтитры разговора в реальном времени."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen потрібен мікрофон, щоб показувати субтитри розмови в реальному часі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen 需要使用麦克风来实时显示对话字幕。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen ውይይትን በቀጥታ በካፕሽን ለማሳየት የአፕልን የንግግር ማወቂያ ይጠቀማል። በOzen ቅንብሮች ውስጥ “ማስኬድ በአፕል አገልጋዮች ላይ ፍቀድ”ን ካላበሩ በስተቀር ማወቂያው በስልኩ ላይ ይከናወናል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Ozen ميزة التعرّف على الكلام من Apple لعرض ترجمة نصية فورية للمحادثة. يتم التعرّف على الهاتف نفسه ما لم تفعّلوا «السماح بالمعالجة على خوادم Apple» في إعدادات Ozen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen nutzt die Spracherkennung von Apple, um Gespräche live zu untertiteln. Die Erkennung läuft auf dem Telefon, es sei denn, Sie aktivieren in den Einstellungen von Ozen „Verarbeitung auf Apples Servern erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen uses Apple’s speech recognition to caption conversation live. It stays on the phone unless you turn on “Allow processing on Apple’s servers” in Ozen’s settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen usa el reconocimiento de voz de Apple para subtitular la conversación en directo. Se hace en el propio teléfono, salvo que actives «Permitir el procesamiento en los servidores de Apple» en los ajustes de Ozen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen utilise la reconnaissance vocale d’Apple pour sous-titrer la conversation en direct. Elle se fait sur le téléphone, sauf si vous activez « Autoriser le traitement sur les serveurs d’Apple » dans les réglages d’Ozen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוזן משתמשת בזיהוי הדיבור של אפל כדי להציג כתוביות לשיחה בזמן אמת. הזיהוי נעשה בטלפון עצמו, אלא אם הפעלתם בהגדרות של אוזן את ״לאפשר עיבוד בשרתי אפל״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत के लाइव कैप्शन दिखाने के लिए Ozen, Apple की बोली पहचान का उपयोग करता है। पहचान फ़ोन पर ही होती है, जब तक आप Ozen की सेटिंग्स में “Apple के सर्वर पर प्रोसेसिंग की अनुमति दें” चालू नहीं करते।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ozen usa o reconhecimento de voz da Apple para legendar a conversa em direto. É feito no próprio telemóvel, a não ser que ative «Permitir processamento nos servidores da Apple» nas definições do Ozen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen использует распознавание речи Apple, чтобы показывать субтитры разговора в реальном времени. Распознавание происходит на самом телефоне, если только вы не включите «Разрешить обработку на серверах Apple» в настройках Ozen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen використовує розпізнавання мовлення Apple, щоб показувати субтитри розмови в реальному часі. Розпізнавання відбувається на самому телефоні, якщо тільки ви не ввімкнете «Дозволити обробку на серверах Apple» в налаштуваннях Ozen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen 使用 Apple 的语音识别来实时显示对话字幕。识别在手机上完成，除非你在 Ozen 的设置中打开“允许在 Apple 服务器上处理”。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
